# Groq API Configuration
GROQ_LLM_API_KEY=your_groq_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Fallback Safety Configuration
OLLAMA_API_KEY=your_ollama_api_key_here
VITE_OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_BASE_URL=https://ollama.com/v1
VITE_OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4.1-flash
VITE_OLLAMA_MODEL=deepseek-v4.1-flash

# Optional: Custom Llama LLM Configuration (Together AI, OpenRouter, Cerebras, Ollama, etc.)
# VITE_LLAMA_API_KEY=your_llama_key_here
# VITE_LLAMA_BASE_URL=https://api.groq.com/openai/v1
# VITE_LLAMA_MODEL=llama-3.3-70b-versatile

# Air Quality Telemetry & Database
VITE_WAQI_TOKEN=your_waqi_token_here
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
